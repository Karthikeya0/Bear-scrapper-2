# Copy to .env (setup.sh does it) and fill in. Never commit .env.

# The address n8n is reachable at. Either a subdomain you point at the server
# (recommended: n8n.bearstudios.in) or, with no DNS change, <server-ip-with-dashes>.sslip.io
N8N_DOMAIN=

# Keep the n8n version the same as (or newer than) the one on your Mac. Check it in n8n: Help → About n8n.
N8N_VERSION=2.43.6

# Encrypts saved credentials. setup.sh copies it from your migrated Mac data, or generates a new one.
# Never change it after the first start, or n8n cannot read its credentials.
N8N_ENCRYPTION_KEY=

TIMEZONE=Asia/Kolkata
