# Copy to .env.local for local development. Never commit real values.

# --- Public (shipped to the browser; safe by design, protected by RLS) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-only (never prefix with NEXT_PUBLIC_) ---
# Base URL of your n8n instance, without a trailing slash or /webhook.
N8N_BASE_URL=https://n8n.example.com
# Must equal N8N_WEBHOOK_SECRET in n8n (checked by the "Validate Secret" node).
N8N_WEBHOOK_SECRET=change-me
