{
  "name": "WF-P4: Podcast Reply Monitor",
  "nodes": [
    {
      "id": "9d1c4b70-0000-4000-8000-000000000199",
      "name": "Every 30 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      }
    },
    {
      "id": "9d1c4b70-0000-4000-8000-000000000201",
      "name": "Dashboard: Check podcast replies",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "wfp4-podcast-replies",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "5a2e9c31-0000-4000-8000-000000000200",
      "credentials": {
        "httpHeaderAuth": {
          "id": "bearDashboardSecret",
          "name": "Bear dashboard secret"
        }
      }
    },
    {
      "id": "9d1c4b70-0000-4000-8000-000000000205",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        100
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "c7d3e100-0000-4000-8000-000000000202",
              "name": "supabase_url",
              "value": "https://YOUR-PROJECT-REF.supabase.co",
              "type": "string"
            },
            {
              "id": "c7d3e100-0000-4000-8000-000000000203",
              "name": "lookback_days",
              "value": 3,
              "type": "number"
            },
            {
              "id": "c7d3e100-0000-4000-8000-000000000204",
              "name": "started_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "9d1c4b70-0000-4000-8000-000000000206",
      "name": "Gmail: recent inbox",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        460,
        100
      ],
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 100,
        "simple": true,
        "filters": {
          "q": "={{ 'in:inbox newer_than:' + $('Config').first().json.lookback_days + 'd -from:me' }}"
        },
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "bearGmail",
          "name": "Gmail account"
        }
      },
      "onError": "continueRegularOutput",
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "9d1c4b70-0000-4000-8000-000000000207",
      "name": "Sent threads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/podcast_outreach?select=podcast_id,thread_id&status=eq.sent&thread_id=not.is.null&order=sent_at.desc&limit=2000",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi"
      },
      "credentials": {
        "supabaseApi": {
          "id": "bearSupabase",
          "name": "Supabase account"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "9d1c4b70-0000-4000-8000-000000000208",
      "name": "Emailed podcasts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/podcast_leads?select=id,email&status=eq.Email%20sent&email=not.is.null&limit=5000",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi"
      },
      "credentials": {
        "supabaseApi": {
          "id": "bearSupabase",
          "name": "Supabase account"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "9d1c4b70-0000-4000-8000-000000000209",
      "name": "Find replies & bounces",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// WF-P4 \"Find replies & bounces\" (Code node, Run Once for All Items).\n// A message in a thread we started with a podcast is a reply (auto-replies ignored);\n// a mailer-daemon message naming a podcast's address is a bounce.\n// Output: one item per podcast { podcast_id, kind: 'replied' | 'bounced', replied_at }.\n\nconst messages = $('Gmail: recent inbox').all().map(i => i.json).filter(m => m && m.threadId)\nconst threadTo = new Map()\nfor (const h of $('Sent threads').all().map(i => i.json)) if (h && h.thread_id && h.podcast_id) threadTo.set(h.thread_id, h.podcast_id)\nconst contacted = $('Emailed podcasts').all().map(i => i.json).filter(l => l && l.id && l.email)\n\nconst AUTO = /(automatic reply|auto[- ]?reply|out of (the )?office|ooo\\b|on vacation|away from the office|autoresponder)/i\nconst BOUNCE_FROM = /(mailer-daemon|postmaster|mail delivery (subsystem|system))/i\n\nconst found = new Map()\nfor (const m of messages) {\n  const from = String(m.From || m.from || '')\n  const text = `${m.Subject || m.subject || ''} ${m.snippet || ''}`\n  if (BOUNCE_FROM.test(from)) {\n    const p = (threadTo.has(m.threadId) && contacted.find(l => l.id === threadTo.get(m.threadId))) ||\n      contacted.find(l => text.toLowerCase().includes(l.email.toLowerCase()))\n    if (p && !found.has(p.id)) found.set(p.id, { podcast_id: p.id, kind: 'bounced' })\n    continue\n  }\n  const id = threadTo.get(m.threadId)\n  if (!id || AUTO.test(text) || !contacted.some(l => l.id === id)) continue\n  const at = m.internalDate ? new Date(Number(m.internalDate)).toISOString() : new Date().toISOString()\n  found.set(id, { podcast_id: id, kind: 'replied', replied_at: at })\n}\n\nreturn [...found.values()].map(json => ({ json }))\n"
      },
      "alwaysOutputData": true
    },
    {
      "id": "9d1c4b70-0000-4000-8000-000000000211",
      "name": "Anything found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1340,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "2e0d1c00-0000-4000-8000-000000000210",
              "leftValue": "={{ !!$json.podcast_id }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "9d1c4b70-0000-4000-8000-000000000212",
      "name": "Update podcast",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        0
      ],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/podcast_leads?id=eq.{{ $json.podcast_id }}&status=eq.Email%20sent",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.kind === 'replied' ? { status: 'Replied', replied_at: $json.replied_at } : { status: 'Dead', skip_reason: 'Email bounced' }) }}"
      },
      "credentials": {
        "supabaseApi": {
          "id": "bearSupabase",
          "name": "Supabase account"
        }
      }
    },
    {
      "id": "9d1c4b70-0000-4000-8000-000000000213",
      "name": "Cancel follow-ups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        0
      ],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/podcast_outreach?podcast_id=eq.{{ $('Find replies & bounces').item.json.podcast_id }}&status=in.(pending_review,scheduled)",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'rejected', rejected_at: new Date().toISOString() }) }}"
      },
      "credentials": {
        "supabaseApi": {
          "id": "bearSupabase",
          "name": "Supabase account"
        }
      }
    },
    {
      "id": "9d1c4b70-0000-4000-8000-000000000214",
      "name": "Run summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Config').first().json\nconst found = $('Find replies & bounces').all().map(i => i.json).filter(f => f && f.podcast_id)\nconst gmailError = $('Gmail: recent inbox').all().map(i => i.json).find(m => m && m.error)\nreturn [{ json: { workflow_name: 'WF-P4-PodcastReplies', status: gmailError ? 'failed' : 'success', replies_detected: found.filter(f => f.kind === 'replied').length, leads_skipped: found.filter(f => f.kind === 'bounced').length, errors: gmailError ? [{ message: 'Gmail: ' + String(gmailError.error.message || gmailError.error).slice(0, 200) }] : null, started_at: cfg.started_at, finished_at: new Date().toISOString() } }]\n"
      },
      "executeOnce": true
    },
    {
      "id": "9d1c4b70-0000-4000-8000-000000000215",
      "name": "Write run log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2220,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/workflow_logs",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "credentials": {
        "supabaseApi": {
          "id": "bearSupabase",
          "name": "Supabase account"
        }
      }
    }
  ],
