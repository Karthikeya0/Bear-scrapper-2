{
  "name": "WF-3b: Send Approved",
  "nodes": [
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000079",
      "name": "Dashboard: Approve & send",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        100
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "approve-and-send",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "7e1f0b2a-0000-4000-8000-000000000078",
      "credentials": {
        "httpHeaderAuth": {
          "id": "bearDashboardSecret",
          "name": "Bear dashboard secret"
        }
      }
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000083",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        100
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "c0f19a00-0000-4000-8000-000000000080",
              "name": "supabase_url",
              "value": "https://YOUR-PROJECT-REF.supabase.co",
              "type": "string"
            },
            {
              "id": "c0f19a00-0000-4000-8000-000000000081",
              "name": "sender_name",
              "value": "Bear Studios",
              "type": "string"
            },
            {
              "id": "c0f19a00-0000-4000-8000-000000000082",
              "name": "started_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000084",
      "name": "Fetch approved email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/outreach_queue?id=eq.{{ $('Dashboard: Approve & send').first().json.body.outreach_id }}&status=eq.approved&select=id,lead_id,subject,body,sequence_step,leads(id,email,name,company,status)",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi"
      },
      "credentials": {
        "supabaseApi": {
          "id": "bearSupabase",
          "name": "Supabase account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000086",
      "name": "Ready to send?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "1f0c0d00-0000-4000-8000-000000000085",
              "leftValue": "={{ !!$json.id && !!($json.leads && $json.leads.email) && !['unsubscribed', 'bounced', 'dead'].includes($json.leads.status) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000087",
      "name": "Gmail: send",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        880,
        0
      ],
      "parameters": {
        "sendTo": "={{ $json.leads.email }}",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.body }}",
        "options": {
          "appendAttribution": false,
          "senderName": "={{ $('Config').first().json.sender_name }}"
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "bearGmail",
          "name": "Gmail account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000089",
      "name": "Sent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "1f0c0d00-0000-4000-8000-000000000088",
              "leftValue": "={{ !!$json.id && !$json.error }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000090",
      "name": "Mark sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -100
      ],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/outreach_queue?id=eq.{{ $('Fetch approved email').first().json.id }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'sent', sent_at: new Date().toISOString() }) }}"
      },
      "credentials": {
        "supabaseApi": {
          "id": "bearSupabase",
          "name": "Supabase account"
        }
      }
    },
