        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ lead_id: $('Fetch approved email').first().json.lead_id, outreach_id: $('Fetch approved email').first().json.id, subject: $('Fetch approved email').first().json.subject, body: $('Fetch approved email').first().json.body, body_sent: $('Fetch approved email').first().json.body, sequence_step: $('Fetch approved email').first().json.sequence_step || 1, thread_id: $('Gmail: send').first().json.threadId || null, message_id: $('Gmail: send').first().json.id || null, sent_at: new Date().toISOString() }) }}"
      },
      "credentials": {
        "supabaseApi": {
          "id": "bearSupabase",
