          "id": "bearDashboardSecret",
          "name": "Bear dashboard secret"
        }
      }
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000124",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        100
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "c0f19a00-0000-4000-8000-000000000121",
              "name": "supabase_url",
              "value": "https://YOUR-PROJECT-REF.supabase.co",
              "type": "string"
            },
            {
              "id": "c0f19a00-0000-4000-8000-000000000122",
              "name": "lookback_days",
              "value": 3,
              "type": "number"
            },
            {
              "id": "c0f19a00-0000-4000-8000-000000000123",
              "name": "started_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000125",
      "name": "Gmail: recent inbox",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        440,
        100
      ],
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 100,
        "simple": true,
        "filters": {
          "q": "={{ 'in:inbox newer_than:' + $('Config').first().json.lookback_days + 'd -from:me' }}"
        },
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "bearGmail",
          "name": "Gmail account"
        }
      },
      "onError": "continueRegularOutput",
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000126",
      "name": "Sent threads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/outreach_history?select=lead_id,thread_id&thread_id=not.is.null&order=sent_at.desc&limit=2000",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi"
      },
      "credentials": {
        "supabaseApi": {
          "id": "bearSupabase",
          "name": "Supabase account"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000127",
      "name": "Contacted leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/leads?select=id,email&status=eq.contacted&email=not.is.null&limit=5000",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi"
      },
      "credentials": {
        "supabaseApi": {
          "id": "bearSupabase",
          "name": "Supabase account"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000128",
      "name": "Find replies & bounces",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// WF-4 \"Find replies & bounces\" (Code node, Run Once for All Items).\n// Input: recent inbox messages from Gmail (simplified: id, threadId, From, Subject, snippet).\n// A message in a thread we started is a reply (auto-replies / out-of-office are ignored);\n// a mailer-daemon message naming a lead's address is a bounce.\n// Output: one item per lead { lead_id, kind: 'replied' | 'bounced', replied_at }.\n\nconst messages = $('Gmail: recent inbox').all().map(i => i.json).filter(m => m && m.threadId)\nconst threadToLead = new Map()\nfor (const h of $('Sent threads').all().map(i => i.json)) if (h && h.thread_id && h.lead_id) threadToLead.set(h.thread_id, h.lead_id)\nconst contacted = $('Contacted leads').all().map(i => i.json).filter(l => l && l.id && l.email)\n\nconst AUTO = /(automatic reply|auto[- ]?reply|out of (the )?office|ooo\\b|on vacation|away from the office|autoresponder)/i\nconst BOUNCE_FROM = /(mailer-daemon|postmaster|mail delivery (subsystem|system))/i\n\nconst found = new Map()\nfor (const m of messages) {\n  const from = String(m.From || m.from || '')\n  const text = `${m.Subject || m.subject || ''} ${m.snippet || ''}`\n  if (BOUNCE_FROM.test(from)) {\n    const lead = (threadToLead.has(m.threadId) && contacted.find(l => l.id === threadToLead.get(m.threadId))) ||\n      contacted.find(l => text.toLowerCase().includes(l.email.toLowerCase()))\n    if (lead && !found.has(lead.id)) found.set(lead.id, { lead_id: lead.id, kind: 'bounced' })\n    continue\n  }\n  const leadId = threadToLead.get(m.threadId)\n  // Only leads still marked contacted, so a reply is counted once, not on every run.\n  if (!leadId || AUTO.test(text) || !contacted.some(l => l.id === leadId)) continue\n  const at = m.internalDate ? new Date(Number(m.internalDate)).toISOString() : new Date().toISOString()\n  found.set(leadId, { lead_id: leadId, kind: 'replied', replied_at: at })\n}\n\nreturn [...found.values()].map(json => ({ json }))\n"
      },
      "alwaysOutputData": true
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000130",
      "name": "Anything found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1320,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "1f0c0d00-0000-4000-8000-000000000129",
              "leftValue": "={{ !!$json.lead_id }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000131",
      "name": "Update lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/leads?id=eq.{{ $json.lead_id }}&status=in.(scored,contacted)",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.kind === 'replied' ? { status: 'replied', replied_at: $json.replied_at } : { status: 'bounced' }) }}"
      },
      "credentials": {
        "supabaseApi": {
          "id": "bearSupabase",
          "name": "Supabase account"
        }
      }
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000132",
      "name": "Cancel follow-ups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/outreach_queue?lead_id=eq.{{ $('Find replies & bounces').item.json.lead_id }}&status=in.(pending_review,scheduled)",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'rejected', rejected_at: new Date().toISOString() }) }}"
      },
      "credentials": {
        "supabaseApi": {
          "id": "bearSupabase",
          "name": "Supabase account"
        }
      }
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000133",
      "name": "Run summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// WF-4 \"Run summary\" (Code node, Run Once for All Items).\nconst cfg = $('Config').first().json\nconst found = $('Find replies & bounces').all().map(i => i.json).filter(f => f && f.lead_id)\nconst gmail = $('Gmail: recent inbox').all().map(i => i.json)\nconst gmailError = gmail.find(m => m && m.error)\nreturn [{\n  json: {\n    workflow_name: 'WF-4-ReplyMonitor',\n    status: gmailError ? 'failed' : 'success',\n    replies_detected: found.filter(f => f.kind === 'replied').length,\n    leads_skipped: found.filter(f => f.kind === 'bounced').length,\n    errors: gmailError\n      ? [{ message: `Gmail: ${String(gmailError.error.message || gmailError.error).slice(0, 200)}` }]\n      : found.some(f => f.kind === 'bounced')\n        ? found.filter(f => f.kind === 'bounced').map(f => ({ lead: f.lead_id, message: 'Email bounced; lead marked bounced.' }))\n        : null,\n    started_at: cfg.started_at,\n    finished_at: new Date().toISOString(),\n  },\n}]\n"
      }
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000134",
      "name": "Write run log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
