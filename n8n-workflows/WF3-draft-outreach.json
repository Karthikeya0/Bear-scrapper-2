            },
            {
              "id": "c0f19a00-0000-4000-8000-000000000062",
              "name": "groq_url",
              "value": "https://api.groq.com/openai/v1/chat/completions",
              "type": "string"
            },
            {
              "id": "c0f19a00-0000-4000-8000-000000000063",
              "name": "groq_model",
              "value": "llama-3.3-70b-versatile",
              "type": "string"
            },
            {
