      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 3
            }
          ]
        }
      }
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000056",
      "name": "Dashboard: Draft outreach",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "wf3-outreach",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "7e1f0b2a-0000-4000-8000-000000000055",
      "credentials": {
        "httpHeaderAuth": {
          "id": "bearDashboardSecret",
          "name": "Bear dashboard secret"
        }
      }
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000065",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        100
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "c0f19a00-0000-4000-8000-000000000057",
              "name": "supabase_url",
              "value": "https://YOUR-PROJECT-REF.supabase.co",
              "type": "string"
            },
            {
              "id": "c0f19a00-0000-4000-8000-000000000058",
              "name": "batch_size",
              "value": 10,
              "type": "number"
            },
            {
              "id": "c0f19a00-0000-4000-8000-000000000059",
              "name": "min_score",
              "value": 60,
              "type": "number"
            },
            {
              "id": "c0f19a00-0000-4000-8000-000000000060",
              "name": "sender_name",
              "value": "Bear Studios",
              "type": "string"
            },
            {
              "id": "c0f19a00-0000-4000-8000-000000000061",
              "name": "portfolio_url",
              "value": "",
