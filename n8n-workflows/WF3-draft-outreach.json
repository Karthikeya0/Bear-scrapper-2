    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000066",
      "name": "Fetch leads to draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/leads?select=*,outreach_queue(id,status)&outreach_queue=is.null&status=eq.scored&outreach_eligible=eq.true&email=not.is.null&ai_score=gte.{{ $json.min_score }}&order=ai_score.desc&limit={{ $json.batch_size }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi"
      },
      "credentials": {
        "supabaseApi": {
          "id": "bearSupabase",
          "name": "Supabase account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000067",
      "name": "Pick leads to draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// WF-3 \"Pick leads to draft\" (Code node, Run Once for All Items).\n// Input: leads returned by Supabase, each with its outreach_queue rows embedded.\n// Keeps leads that have an email and have never had a draft (any status, so rejected\n// drafts are not rewritten). The database query already filters most of this; this is a safety net.\n\nconst cfg = $('Config').first().json\nconst MAX = Number(cfg.batch_size) || 10\nconst seen = new Set()\n\nconst picked = $input\n  .all()\n  .map(i => i.json)\n  .filter(l => l && l.id && l.email && !seen.has(l.email.toLowerCase()) && seen.add(l.email.toLowerCase()))\n  .filter(l => !Array.isArray(l.outreach_queue) || l.outreach_queue.length === 0)\n  .slice(0, MAX)\n\n// Pull the opening line WF-2 saved (\"Hook: …\") out of the reasoning text.\nreturn picked.map(l => {\n  const hook = String(l.ai_reasoning || '').match(/Hook:\\s*(.+)/i)?.[1]?.trim() || null\n  const firstName = String(l.name || '').trim().split(/\\s+/)[0] || null\n  const { outreach_queue, ...lead } = l\n  return { json: { ...lead, hook, first_name: firstName && /^[A-Za-z][\\w'-]*$/.test(firstName) ? firstName : null } }\n})\n"
      },
      "alwaysOutputData": true
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000069",
      "name": "Anything to draft?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "1f0c0d00-0000-4000-8000-000000000068",
              "leftValue": "={{ !!$json.id }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000070",
      "name": "Groq: write email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.groq_url }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 2500
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Config').first().json.groq_model, temperature: 0.6, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: \"You write short cold emails for Bear Studios, a small studio that makes brand launch videos, promo videos and SaaS explainer videos for startups. Write to the founder of the company described. Rules: plain text, 60-110 words, no markdown, no emojis, no exclamation marks. Open with the provided hook or another specific detail about what they built or launched (never \\\"I hope this finds you well\\\"). Then offer ONE fitting service: no video on their homepage -> a 60-90s explainer; just launched -> a launch/promo video for socials; otherwise whichever fits best. Never invent facts, numbers, clients or results. Mention the portfolio link only if one is given. End with a soft, low-effort question (e.g. \\\"Worth a quick look at a few examples?\\\"), then sign off with the sender name on its own line. Address the founder by first name if given, otherwise \\\"Hi there\\\". Subject: under 7 words, lowercase is fine, specific to them, no clickbait. Output ONLY JSON: {\\\"subject\\\": \\\"...\\\", \\\"body\\\": \\\"...\\\"}\" }, { role: 'user', content: ['Founder first name: ' + ($json.first_name || 'unknown'), 'Founder role: ' + ($json.founder_role || 'unknown'), 'Company: ' + ($json.company || '?'), 'Website: ' + ($json.website || $json.company_domain || '?'), 'Launched: ' + ($json.launched_at || 'unknown') + ' (via ' + $json.source + ')', 'Homepage has a video: ' + ($json.has_video === null || $json.has_video === undefined ? 'unknown' : $json.has_video), 'Signals: ' + (Array.isArray($json.signals) ? $json.signals.join(', ') : ''), 'Hook: ' + ($json.hook || 'none'), 'About: ' + String($json.bio || $json.post_content || '').slice(0, 1200), 'Sender name: ' + $('Config').first().json.sender_name, 'Portfolio link: ' + ($('Config').first().json.portfolio_url || 'none')].join('\\n') } ] }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "bearGroq",
          "name": "Groq API key"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000071",
      "name": "Build drafts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// WF-3 \"Build drafts\" (Code node, Run Once for All Items).\n// Input: one Groq response per picked lead, in the same order.\n// Output: ONE item { rows: [...outreach_queue rows], drafted, failed: [...] }.\n\nconst leads = $('Pick leads to draft').all().map(i => i.json)\nconst rows = []\nconst failed = []\n\n$input.all().forEach((item, i) => {\n  const lead = leads[i]\n  if (!lead) return\n  const res = item.json || {}\n  try {\n    const email = JSON.parse(res.choices[0].message.content)\n    const subject = String(email.subject || '').replace(/\\s+/g, ' ').trim().slice(0, 120)\n    const body = String(email.body || '').replace(/\\r\\n/g, '\\n').trim()\n    if (!subject || body.length < 40) throw new Error('empty subject or body')\n    rows.push({ lead_id: lead.id, subject, body, status: 'pending_review', sequence_step: 1 })\n  } catch (e) {\n    const reason = res.error ? String(res.error.message || res.error) : String(e.message || e)\n    failed.push({ lead: lead.id, email: lead.email, message: `Draft failed: ${reason.slice(0, 200)}` })\n  }\n})\n\nreturn [{ json: { rows, drafted: rows.length, failed } }]\n"
      }
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000073",
      "name": "Any drafts?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1560,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "1f0c0d00-0000-4000-8000-000000000072",
              "leftValue": "={{ $json.rows.length > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000074",
      "name": "Queue for review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/outreach_queue",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.rows) }}"
      },
      "credentials": {
        "supabaseApi": {
          "id": "bearSupabase",
          "name": "Supabase account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000075",
      "name": "Run summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// WF-3 \"Run summary\" (Code node, Run Once for All Items).\n// One workflow_logs row per run. Drafts are counted in leads_scored (emails_sent stays 0:\n// nothing is sent until you approve a draft in the dashboard).\n\nconst cfg = $('Config').first().json\n// Build drafts does not run when there was nothing to draft.\nconst built = $('Build drafts').isExecuted ? $('Build drafts').first().json : { drafted: 0, failed: [] }\n\nreturn [{\n  json: {\n    workflow_name: 'WF-3-Outreach',\n    status: built.drafted === 0 && built.failed.length > 0 ? 'failed' : 'success',\n    leads_scraped: 0,\n    leads_skipped: built.failed.length,\n    leads_scored: built.drafted,\n    emails_sent: 0,\n    replies_detected: 0,\n    errors: built.failed.length ? built.failed : null,\n    started_at: cfg.started_at,\n    finished_at: new Date().toISOString(),\n  },\n}]\n"
      }
    },
    {
      "id": "b3a5e7c1-0000-4000-8000-000000000076",
      "name": "Write run log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2220,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/workflow_logs",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "credentials": {
        "supabaseApi": {
          "id": "bearSupabase",
          "name": "Supabase account"
        }
      }
    }
  ],
